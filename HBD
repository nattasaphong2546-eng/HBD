<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>Happy Birthday Baby 🎂</title>
<style>
body {
    margin: 0;
    font-family: 'Comic Sans MS', 'Segoe UI', sans-serif;
    background: linear-gradient(120deg, #ffd6e8, #ffeaf4);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.card {
    background: white;
    width: 350px;
    padding: 25px;
    border-radius: 25px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(255,100,150,0.3);
}

h1 {
    color: #ff6fae;
    font-size: 32px;
    margin-bottom: 10px;
}

.slider {
    width: 100%;
    height: 220px;
    overflow: hidden;
    border-radius: 20px;
    margin: 15px 0;
}

.slides {
    display: flex;
    width: 300%;
    height: 100%;
    transition: 0.8s;
}

.slides img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

p {
    font-size: 18px;
    color: #555;
}

button {
    background: #ff6fae;
    border: none;
    padding: 12px 25px;
    color: white;
    font-size: 16px;
    border-radius: 30px;
    margin-top: 15px;
    cursor: pointer;
}

button:hover {
    background: #ff4f9a;
}
</style>
</head>
<body>

<div class="card">
    <h1>🎂 Happy Birthday เบบี๋ 🎀</h1>

    <div class="slider">
        <div class="slides" id="slides">
            <img src="img1.jpg">
            <img src="img2.jpg">
            <img src="img3.jpg">
        </div>
    </div>

    <p id="text">ขอให้เบบี๋มีความสุขมากๆ นะ 💕</p>
    <button onclick="next()">กดดูรูปต่อ 📸</button>
</div>

<script>
let index = 0;
const slides = document.getElementById("slides");

const texts = [
    "ขอให้เบบี๋ยิ้มเยอะๆ ทุกวันเลยนะ 😊",
    "ขอให้ได้ทุกอย่างที่อยากได้ 🎁",
    "อยู่กับเค้าไปนานๆ เลยน้า 💖",
    "Happy Birthday Baby 🎂✨"
];

function next() {
    index = (index + 1) % 3;
    slides.style.transform = "translateX(" + (-index * 100) + "%)";
    document.getElementById("text").innerText = texts[index];
}
</script>

</body>
</html>
